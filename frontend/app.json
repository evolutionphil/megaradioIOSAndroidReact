{
  "expo": {
    "name": "MegaRadio",
    "slug": "megaradio",
    "version": "1.0.70",
    "newArchEnabled": false,
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": [
      "megaradio",
      "com.googleusercontent.apps.957628580421-664s6dft9n8kp91futrnpsugd4fcsonn"
    ],
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.visiongo.megaradio",
      "associatedDomains": ["applinks:themegaradio.com"],
      "buildNumber": "5",
      "usesAppleSignIn": true,
      "splash": {
        "image": "./assets/images/splash.png",
        "resizeMode": "cover",
        "backgroundColor": "#000000"
      },
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio",
          "fetch",
          "remote-notification",
          "processing"
        ],
        "UIRequiredDeviceCapabilities": [
          "armv7"
        ],
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": ["megaradio"]
          },
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.957628580421-664s6dft9n8kp91futrnpsugd4fcsonn"
            ]
          }
        ],
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsArbitraryLoadsForMedia": true,
          "NSAllowsArbitraryLoadsInWebContent": false
        },
        "NSLocationWhenInUseUsageDescription": "MegaRadio uses your location to find nearby radio stations.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "MegaRadio uses your location to find nearby radio stations.",
        "NSPhotoLibraryUsageDescription": "Photo library access is required to upload a profile picture.",
        "ITSAppUsesNonExemptEncryption": false,
        "BGTaskSchedulerPermittedIdentifiers": [
          "com.visiongo.megaradio.refresh",
          "com.visiongo.megaradio.processing"
        ],
        "NSUserActivityTypes": [
          "INPlayMediaIntent",
          "com.visiongo.megaradio.playMedia"
        ],
        "NSSiriUsageDescription": "MegaRadio uses Siri to play radio stations with voice commands."
      },
      "entitlements": {
        "com.apple.developer.carplay-audio": true
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": ["C617.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": ["35F9.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": ["E174.1"]
          }
        ],
        "NSPrivacyCollectedDataTypes": [
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeCrashData",
            "NSPrivacyCollectedDataTypeLinked": false,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": ["NSPrivacyCollectedDataTypePurposeAppFunctionality"]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypePerformanceData",
            "NSPrivacyCollectedDataTypeLinked": false,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": ["NSPrivacyCollectedDataTypePurposeAppFunctionality"]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeProductInteraction",
            "NSPrivacyCollectedDataTypeLinked": false,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": ["NSPrivacyCollectedDataTypePurposeAnalytics"]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeCoarseLocation",
            "NSPrivacyCollectedDataTypeLinked": false,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": ["NSPrivacyCollectedDataTypePurposeAppFunctionality"]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FF4199"
      },
      "splash": {
        "image": "./assets/images/splash.png",
        "resizeMode": "cover",
        "backgroundColor": "#000000"
      },
      "package": "com.megaradio",
      "intentFilters": [{
        "action": "VIEW",
        "autoVerify": true,
        "category": ["BROWSABLE", "DEFAULT"],
        "data": [
          { "scheme": "https", "host": "themegaradio.com", "pathPrefix": "/station/" },
          { "scheme": "https", "host": "themegaradio.com", "pathPrefix": "/user/" },
          { "scheme": "https", "host": "themegaradio.com", "pathPrefix": "/genre/" },
          { "scheme": "https", "host": "themegaradio.com", "pathPattern": "/.*/station/.*" },
          { "scheme": "https", "host": "themegaradio.com", "pathPattern": "/.*/user/.*" },
          { "scheme": "https", "host": "themegaradio.com", "pathPattern": "/.*/genre/.*" }
        ]
      }],
      "versionCode": 92,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "ACCESS_WIFI_STATE",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "WAKE_LOCK",
        "VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-quick-actions",
        {
          "iosActions": [
            {
              "id": "play-last",
              "title": "Play Last Station",
              "icon": "symbol:play.circle",
              "params": { "action": "play-last" }
            }
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "useLegacyPackaging": true,
            "newArchEnabled": false,
            "kotlinVersion": "2.0.0",
            "extraProguardRules": "-keep class io.invertase.** { *; }\n-keep class com.google.android.gms.ads.** { *; }"
          },
          "ios": {
            "useFrameworks": "static",
            "newArchEnabled": false,
            "fabricEnabled": false
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#FF4199",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "MegaRadio uses your location to find nearby radio stations."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Photo library access is required to upload a profile picture.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "ios": {
            "allowsBackgroundAudioPlayback": true
          },
          "android": {
            "allowsBackgroundAudioPlayback": true
          }
        }
      ],
      "./plugins/withAndroidBuildFix.js",
      "./plugins/withAppIntents.js",
      "./plugins/withAndroidAppActions.js",
      "./plugins/withAirPlay.js",
      "./plugins/withAndroidAutoFull.js",
      "./plugins/withCleartextTraffic.js",
      "./plugins/withSwift5Mode.js",
      "react-native-google-cast",
      "./plugins/withAdMobFix.js",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-8771434485570434~7427742767",
          "iosAppId": "ca-app-pub-8771434485570434~4044224468",
          "userTrackingPermission": "MegaRadio uses your device information to provide you with a better and more personalized advertising experience."
        }
      ],
      "./plugins/withTrackPlayerServiceFix.js",
      "./plugins/withCarPlayNativeFix.js",
      "./plugins/withCarPlayScenes.js",
      "./plugins/withSwiftAudioExRadioFix.js",
      "./plugins/withCompanionBridges.js",
      "@react-native-firebase/app",
      "@react-native-firebase/crashlytics",
      "./plugins/withGoogleServicesFix.js",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.957628580421-664s6dft9n8kp91futrnpsugd4fcsonn"
        }
      ],
      "./plugins/withFmtFix.js",
      "./plugins/withWatchOSBuildFix.js"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "websiteUrl": "https://themegaradio.com",
      "appStoreUrl": "https://apps.apple.com/app/id6759302561",
      "playStoreUrl": "https://play.google.com/store/apps/details?id=com.megaradio",
      "router": {},
      "eas": {
        "projectId": "8c6c2a63-f514-4419-93c1-975a3e9119ca"
      }
    }
  }
}
