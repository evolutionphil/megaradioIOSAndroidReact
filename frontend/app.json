{
  "react-native-google-mobile-ads": {
    "android_app_id": "ca-app-pub-8771434485570434~7427742767",
    "ios_app_id": "ca-app-pub-8771434485570434~4044224468"
  },
  "expo": {
    "name": "MegaRadio",
    "slug": "megaradio",
    "version": "1.0.68",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": [
      "megaradio",
      "com.googleusercontent.apps.957628580421-664s6dft9n8kp91futrnpsugd4fcsonn"
    ],
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.visiongo.megaradio",
      "buildNumber": "68",
      "usesAppleSignIn": true,
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio",
          "fetch",
          "remote-notification",
          "processing"
        ],
        "UIRequiredDeviceCapabilities": [
          "armv7"
        ],
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.957628580421-664s6dft9n8kp91futrnpsugd4fcsonn"
            ]
          }
        ],
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsArbitraryLoadsForMedia": true,
          "NSAllowsArbitraryLoadsInWebContent": false
        },
        "NSLocationWhenInUseUsageDescription": "MegaRadio uses your location to find nearby radio stations.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "MegaRadio uses your location to find nearby radio stations.",
        "NSPhotoLibraryUsageDescription": "Photo library access is required to upload a profile picture.",
        "NSCameraUsageDescription": "Camera access is required to take a profile picture.",
        "NSMicrophoneUsageDescription": "Microphone access is required for audio recording.",
        "ITSAppUsesNonExemptEncryption": false,
        "BGTaskSchedulerPermittedIdentifiers": [
          "com.visiongo.megaradio.refresh",
          "com.visiongo.megaradio.processing"
        ],
        "NSUserActivityTypes": [
          "INPlayMediaIntent",
          "com.visiongo.megaradio.playMedia"
        ],
        "NSSiriUsageDescription": "MegaRadio uses Siri to play radio stations with voice commands."
      },
      "entitlements": {
        "com.apple.developer.carplay-audio": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FF4199"
      },
      "splash": {
        "image": "./assets/images/splash.png",
        "resizeMode": "cover",
        "backgroundColor": "#000000"
      },
      "package": "com.megaradio",
      "versionCode": 90,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "ACCESS_WIFI_STATE",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "WAKE_LOCK",
        "VIBRATE",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "CAMERA",
        "RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "newArchEnabled": false,
            "kotlinVersion": "2.0.0",
            "extraProguardRules": "-keep class io.invertase.** { *; }\n-keep class com.google.android.gms.ads.** { *; }"
          },
          "ios": {
            "useFrameworks": "static",
            "newArchEnabled": false,
            "fabricEnabled": false
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#FF4199",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "MegaRadio uses your location to find nearby radio stations."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Photo library access is required to upload a profile picture."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Ses kaydı yapabilmek için mikrofon erişimi gereklidir.",
          "ios": {
            "allowsBackgroundAudioPlayback": true
          },
          "android": {
            "allowsBackgroundAudioPlayback": true
          }
        }
      ],
      "./plugins/withAndroidBuildFix.js",
      "./plugins/withAirPlay.js",
      "./plugins/withAndroidAutoFull.js",
      "./plugins/withCleartextTraffic.js",
      "./plugins/withSwift5Mode.js",
      "react-native-google-cast",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-8771434485570434~7427742767",
          "iosAppId": "ca-app-pub-8771434485570434~4044224468",
          "userTrackingPermission": "MegaRadio, size daha iyi ve kişiselleştirilmiş bir reklam deneyimi sunmak için cihaz bilgilerinizi kullanmak istiyor."
        }
      ],
      "./plugins/withAdMobFix.js",
      "./plugins/withTrackPlayerServiceFix.js",
      "./plugins/withCarPlayNativeFix.js",
      "@react-native-firebase/app",
      "@react-native-firebase/crashlytics",
      "./plugins/withGoogleServicesFix.js",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.957628580421-664s6dft9n8kp91futrnpsugd4fcsonn"
        }
      ],
      "./plugins/withSplashScreenFix.js",
      "./plugins/withFmtFix.js",
      "./plugins/withWatchOSBuildFix.js"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
