/*
  Access-Control-Allow-Origin: *
/
  Cache-Control: no-cache, max-age=0, must-revalidate
/index.html
  Cache-Control: no-cache, max-age=0, must-revalidate
/version.json
  Cache-Control: no-cache, no-store, must-revalidate
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/js/*
  Cache-Control: no-cache, max-age=0, must-revalidate
/css/*
  Cache-Control: no-cache, max-age=0, must-revalidate
