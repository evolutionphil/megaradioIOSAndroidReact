<?xml version="1.0" encoding="utf-8"?>
<!-- Required by the SEARCH intent-filter in AndroidManifest.xml so the
     Assistant knows what the app can search for and which hint text to show. -->
<searchable xmlns:android="http://schemas.android.com/apk/res/android"
    android:label="@string/app_name"
    android:hint="Search radio stations, genres, countries"
    android:voiceSearchMode="showVoiceSearchButton|launchRecognizer" />
