{
  "name": "megaradio-desktop",
  "version": "1.0.3",
  "description": "MegaRadio Desktop App (Windows / Linux / macOS) — Electron wrapper around the TV web build",
  "private": true,
  "author": {
    "name": "Vision Go GmbH",
    "email": "contact@visiongo.com"
  },
  "homepage": "https://megaradio.app",
  "main": "electron/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/evolutionphil/megaradioIOSAndroidReact.git"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "build:linux": "node ./node_modules/electron-builder/cli.js --config electron-builder.config.js --linux AppImage deb",
    "build:win": "node ./node_modules/electron-builder/cli.js --config electron-builder.config.js --win nsis portable",
    "build:mac": "node ./node_modules/electron-builder/cli.js --config electron-builder.config.js --mac dmg --universal",
    "build:mas": "node ./node_modules/electron-builder/cli.js --config electron-builder.config.js --mac mas --universal",
    "build:mas-dev": "node ./node_modules/electron-builder/cli.js --config electron-builder.config.js --mac mas-dev --universal",
    "build:all": "node ./node_modules/electron-builder/cli.js --config electron-builder.config.js -mwl",
    "finalize:mac": "node build/finalize-mac-distribution.js"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3"
  },
  "dependencies": {
    "electron-log": "^5.2.0",
    "electron-updater": "^6.3.9"
  },
  "build": {
    "appId": "com.visiongo.megaradio",
    "productName": "MegaRadio",
    "copyright": "© ${new Date().getFullYear()} MegaRadio",
    "asar": true,
    "publish": [
      {
        "provider": "github",
        "owner": "evolutionphil",
        "repo": "megaradioIOSAndroidReact"
      }
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "build/icon.png",
      "package.json",
      "!node_modules/**/*.md",
      "!node_modules/**/test/**",
      "!node_modules/**/*.map"
    ],
    "linux": {
      "category": "AudioVideo",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "MegaRadio-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MegaRadio",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "MegaRadio-Portable-${version}-${arch}.${ext}"
    },
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.music",
      "identity": "Vision Go GmbH (M6T85HP76P)",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "notarize": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "MegaRadio does not use the microphone.",
        "NSCameraUsageDescription": "MegaRadio does not use the camera.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ]
    },
    "mas": {
      "category": "public.app-category.music",
      "type": "distribution",
      "identity": "Vision Go GmbH (M6T85HP76P)",
      "hardenedRuntime": false,
      "entitlements": "build/entitlements.mas.plist",
      "entitlementsInherit": "build/entitlements.mas.inherit.plist",
      "provisioningProfile": "build/embedded.provisionprofile",
      "extendInfo": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "target": [
        {
          "target": "mas",
          "arch": [
            "universal"
          ]
        }
      ]
    },
    "masDev": {
      "type": "development",
      "provisioningProfile": "build/embedded.provisionprofile"
    },
    "pkg": {
      "identity": "3rd Party Mac Developer Installer: Vision Go GmbH (M6T85HP76P)"
    },
    "dmg": {
      "title": "MegaRadio",
      "icon": "build/icon.png",
      "sign": false
    },
    "afterSign": "build/notarize.js"
  }
}
