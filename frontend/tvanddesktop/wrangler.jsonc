{
  "name": "megaradio-tv-cdn",
  "main": "cdn-ci/worker.mjs",
  "compatibility_date": "2024-12-01",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "cdn.themegaradio.com/*",
      "zone_name": "themegaradio.com"
    }
  ],
  "assets": {
    "directory": "./cdn-dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "services": [
    {
      "binding": "LEGACY_CDN",
      "service": "megaradio-tv"
    }
  ]
}
