istTemplate({\n        title: genre,\n        sections: [{\n          header: `${genre} (${stationsSlice.length})`,\n          items\n        }],\n        onItemSelect: async ({\n          index\n        }) => {\n          const station = stationsSlice[index];\n          if (station && playStationCallback) {\n            CarPlayLogger.default.stationSelected(station.name, station._id);\n            console.log('[CarPlay] Playing from genre:', station.name);\n            try {\n              await playStationCallback(station);\n              CarPlayLogger.default.playbackStarted(station.name, station.url_resolved || station.url);\n              showNowPlayingTemplate(station);\n            } catch (e) {\n              CarPlayLogger.default.playbackError(e, station.name);\n            }\n          }\n        }\n      });\n      CarPlay.pushTemplate(template, true);\n      CarPlayLogger.default.templateCreated(`GenreStations-${genre}`, {\n        stationCount: Math.min(stations.length, 50)\n      });\n    } catch (error) {\n      CarPlayLogger.default.templateError(`GenreStations-${genre}`, error);\n      console.error('[CarPlay] Error showing genre stations:', error);\n    }\n  };\n\n  // Create Browse/Popular Stations List Template (50 stations with logos)\n  const createBrowseTemplate = async () => {\n    CarPlayLogger.default.templateCreating('Browse');\n    if (!ListTemplate || !getStationsCallback) {\n      CarPlayLogger.default.templateFailed('Browse', 'ListTemplate or callback not available');\n      return null;\n    }\n    try {\n      CarPlayLogger.default.dataLoading('popularStations');\n\n      // COLD START FIX: Increased timeout to 10s for cold start scenarios\n      const TIMEOUT_MS = 10000;\n      const timeoutPromise = new Promise(resolve => setTimeout(() => {\n        console.log('[CarPlay] Browse/Popular timeout - returning empty');\n        resolve([]);\n      }, TIMEOUT_MS));\n      const stations = await Promise.race([getStationsCallback(), timeo